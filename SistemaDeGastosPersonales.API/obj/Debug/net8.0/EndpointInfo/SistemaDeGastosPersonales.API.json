  "components": {
    "schemas": {
      "CategoriaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "GastoCreacionDto": {
        "required": [
          "categoriaId",
          "fecha",
          "metodoPagoId",
          "monto"
        ],
        "type": "object",
        "properties": {
          "monto": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "descripcion": {
            "type": "string",
            "nullable": true
          },
          "categoriaId": {
            "type": "integer",
            "format": "int32"
          },
          "metodoPagoId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MetodoPagoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "icono": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PresupuestoDto": {
        "required": [
          "anio",
          "categoriaId",
          "mes",
          "montoMaximo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "categoriaId": {
            "type": "integer",
            "format": "int32"
          },
          "montoMaximo": {
            "type": "number",
            "format": "double"
          },
          "anio": {
            "maximum": 2100,
            "minimum": 2020,
            "type": "integer",
            "format": "int32"
          },
          "mes": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UsuarioRegistroDto": {
        "required": [
          "email",
          "nombre",
          "password"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Pon el token así: Bearer {tu_token}",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}